# Host port overrides. Copy to .env if the defaults collide with something already
# running. Only the host side changes; addresses inside the Docker network are fixed.
#
#   cp deploy/compose/.env.example deploy/compose/.env
#
# The demo and smoke scripts read this file, so overriding here is enough — no need to
# pass the ports again on the command line.

PAYMENT_API_PORT=8080
ROUTER_PORT=8081
LEDGER_PORT=8083
ACQUIRER_SIM_PORT=8082
POSTGRES_PORT=5432
KAFKA_PORT=19092

# Observability overlay (docker-compose.observability.yml) only.
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
